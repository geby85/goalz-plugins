{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "goalz": {
      "type": "streamable-http",
      "url": "https://www.goalz.de/mcp/apps",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "resource": "https://www.goalz.de/mcp/apps",
            "baseScopes": [
              "manager:read",
              "manager:manage",
              "club:read",
              "club:manage",
              "transfers:write",
              "messages:read",
              "messages:write"
            ]
          }
        }
      }
    }
  }
}
